{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check && npm run brand:assets && npm run pdfjs:assets && npm run workers:build",
    "build": "next build",
    "postbuild": "node scripts/postbuild-root-locale.mjs && node scripts/postbuild-headers.mjs && node scripts/postbuild-base-path.mjs && node scripts/postbuild-worker-maps.mjs && node scripts/check-bundles.mjs",
    "start": "npx --yes serve@14 out",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run contract:check",
    "verify": "npm run build && npx playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks",
    "size": "node scripts/check-bundles.mjs",
    "size:update": "node scripts/measure-bundles.mjs",
    "contract": "openapi-ts && node scripts/generate-mocks.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "contract:extract": "node scripts/extract-contract.mjs",
    "fonts": "node scripts/sync-fonts.mjs",
    "brand:assets": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-brand-assets.mjs",
    "pdfjs:assets": "node scripts/copy-pdfjs-assets.mjs",
    "workers:build": "node scripts/build-workers.mjs",
    "probe:workers": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probe-workers.mjs",
    "predev": "npm run brand:assets && npm run pdfjs:assets && npm run workers:build"
  },
  "dependencies": {
    "@citation-js/core": "0.8.2",
    "@citation-js/plugin-bibtex": "0.8.2",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.10",
    "@joplin/turndown-plugin-gfm": "1.0.67",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@mixmark-io/domino": "2.2.0",
    "@next/mdx": "16.3.4",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.102.8",
    "@turbodocx/html-to-docx": "1.22.2",
    "@unified-latex/unified-latex-util-parse": "1.8.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror-lang-bib": "0.2.4",
    "fflate": "0.8.3",
    "gray-matter": "4.0.3",
    "idb": "8.0.3",
    "immer": "11.1.18",
    "lucide-react": "1.38.0",
    "mammoth": "1.12.2",
    "markdown-it": "15.0.1",
    "motion": "13.1.1",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.1",
    "react-error-boundary": "6.1.4",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "tailwind-merge": "3.6.0",
    "turndown": "7.2.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "culori": "4.0.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.4.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "simple-git-hooks": "2.14.0",
    "size-limit": "13.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "wawoff2": "2.0.1",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@hey-api/openapi-ts": {
      "js-yaml": "^4.3.2"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mjs}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
