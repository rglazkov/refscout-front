{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check && npm run brand:assets",
    "build": "next build",
    "postbuild": "node scripts/postbuild-root-locale.mjs && node scripts/postbuild-headers.mjs && node scripts/check-bundles.mjs",
    "start": "npx --yes serve@14 out",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run contract:check",
    "verify": "npm run build && npx playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks",
    "size": "node scripts/check-bundles.mjs",
    "size:update": "node scripts/measure-bundles.mjs",
    "contract": "openapi-ts && node scripts/generate-mocks.mjs",
    "contract:check": "npm run contract && git diff --exit-code -- src/lib/api/wire src/test/msw",
    "contract:extract": "node scripts/extract-contract.mjs",
    "fonts": "node scripts/sync-fonts.mjs",
    "brand:assets": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-brand-assets.mjs",
    "predev": "npm run brand:assets"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "immer": "11.1.18",
    "lucide-react": "1.34.0",
    "motion": "13.1.1",
    "next": "16.3.3",
    "next-intl": "4.14.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.1",
    "react-error-boundary": "6.1.3",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/culori": "4.0.1",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "culori": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.11.0",
    "lint-staged": "17.4.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.3",
    "simple-git-hooks": "2.13.1",
    "size-limit": "13.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wawoff2": "2.0.1",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@hey-api/openapi-ts": {
      "js-yaml": "^4.3.2"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mjs}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
