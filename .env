# Public values, not secrets: the file is committed so that a CI build does not
# depend on anyone's local machine settings. Secrets belong in .env.local only.
NEXT_PUBLIC_SITE_URL=https://refscout.app
# Named by connect-src, and the absolute address violation reports are
# posted to - a relative one would send them into a 404 (config/security-headers.mjs).
NEXT_PUBLIC_API_ORIGIN=https://api.refscout.app
# Which server answers. `mock` serves the contract example bodies from a
# service worker in the tab; `stand` is the API named above. Both go through the
# same client, so switching needs no code change.
NEXT_PUBLIC_API_SOURCE=mock
